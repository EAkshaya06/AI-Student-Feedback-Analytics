{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "flask",
      "functions": {
        "app.py": {
          "maxDuration": 60,
          "includeFiles": "{frontend/**,backend/data/recommendations.txt}",
          "excludeFiles": "{.venv/**,backend/data/*.csv,backend/models/**,ml/**,**/__pycache__/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}
