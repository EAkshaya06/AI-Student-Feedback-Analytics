{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "flask",
      "functions": {
        "app.py": {
          "maxDuration": 60,
          "includeFiles": "{frontend/**,backend/data/**}",
          "excludeFiles": "{.venv/**,backend/models/**,ml/**,**/__pycache__/**,cloud-cost-optimization/**,live-update/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
